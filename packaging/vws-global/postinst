#!/bin/sh
set -eu
case "$1" in
    configure)
        for user in vws-console-api vws-aws-proxy vws-iam vws-console; do
            if ! getent passwd "$user" >/dev/null; then
                adduser --system --group --home /nonexistent --no-create-home \
                    --shell /usr/sbin/nologin "$user"
            fi
        done
        if [ -L /etc/vws/credentials ]; then
            echo "vws-global: credentials directory must not be a symlink" >&2
            exit 1
        fi
        install -d -o root -g root -m 0700 /etc/vws/credentials
        if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
        ;;
esac
