# /etc/vws-region/<instance>.env: one file per instance, KEY=VALUE only, no secrets.
# Two instances on one host need different ports.
VWS_REGION_ADDR=:8443
VWS_REGION_OPS_ADDR=127.0.0.1:8085
# Optional; defaults are /etc/vws-region/<instance>/region.crt and global-ca.pem.
# VWS_REGION_TLS_CERT=/etc/vws-region/<instance>/region.crt
# VWS_REGION_TLS_CA=/etc/vws-region/<instance>/global-ca.pem
