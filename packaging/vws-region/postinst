#!/bin/sh
set -eu
case "$1" in
    configure)
        mounts=/proc/self/mounts
        if [ "${VWS_REGION_TEST_MOUNTS+x}" = x ]; then
            if [ "${VWS_REGION_TEST:-}" != 1 ] || [ -z "$VWS_REGION_TEST_MOUNTS" ]; then
                echo "vws-region: mounts override requires VWS_REGION_TEST=1 and a fixture path" >&2
                exit 1
            fi
            mounts=$VWS_REGION_TEST_MOUNTS
        fi
        if awk '$1 == "/dev/fuse" && $2 == "/etc/pve" && $3 == "fuse" { found = 1 }
                END { exit !found }' "$mounts"; then
            if [ -L /etc/pve/vws ]; then
                echo "vws-region: lease directory /etc/pve/vws must not be a symlink" >&2
                exit 1
            fi
            mkdir -p /etc/pve/vws
            for dir in /etc/pve/priv/vws /etc/pve/priv/lock/vws-region; do
                if [ -L "$dir" ]; then
                    echo "vws-region: $dir must not be a symlink" >&2
                    exit 1
                fi
                mkdir -p "$dir"
            done
        fi
        if ! getent passwd vws-region >/dev/null; then
            adduser --system --group --home /nonexistent --no-create-home \
                --shell /usr/sbin/nologin vws-region
        fi
        if [ -L /etc/vws/credentials ]; then
            echo "vws-region: credentials directory must not be a symlink" >&2
            exit 1
        fi
        install -d -o root -g root -m 0700 /etc/vws/credentials
        key=/etc/vws/credentials/region-kek
        if [ -e "$key" ] || [ -L "$key" ]; then
            if [ -L "$key" ] || [ ! -f "$key" ] || \
                [ "$(stat -c '%u:%g:%a:%s' "$key")" != "0:0:600:32" ]; then
                echo "vws-region: region-kek must be root:root 0600 and 32 bytes" >&2
                exit 1
            fi
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
        fi
        ;;
esac
