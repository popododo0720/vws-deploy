#!/bin/sh
set -eu
case "${1:-}" in
    member) files='ca.crt member.crt member.key' ;;
    client) files='ca.crt client.crt client.key' ;;
    installed) files='ca.crt member.crt member.key client.crt client.key' ;;
    *) echo "usage: $0 member|client|installed" >&2; exit 2 ;;
esac
dir=/etc/vws/credentials
if [ -L /etc/vws ] || [ -L "$dir" ] || [ ! -d "$dir" ] || \
    [ "$(stat -c '%u:%g:%a' "$dir")" != 0:0:700 ]; then
    echo "vws-etcd: credentials directory must be root:root 0700, without symlinks" >&2
    exit 1
fi
for name in $files; do
    file=$dir/$name
    if [ "$1" = installed ] && [ ! -e "$file" ] && [ ! -L "$file" ]; then
        continue
    fi
    if [ -L "$file" ] || [ ! -f "$file" ] || \
        [ "$(stat -c '%u:%g:%a' "$file")" != 0:0:600 ]; then
        echo "vws-etcd: $file must be a regular root:root 0600 file, without symlinks" >&2
        exit 1
    fi
done
