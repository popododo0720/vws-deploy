{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "namespaces",
    "services"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "storageClass"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*(/[a-z0-9._-]+)+$"
        },
        "storageClass": {
          "type": "string"
        },
        "pendingFlags": {
          "type": "boolean"
        },
        "probe": {
          "type": "string",
          "enum": [
            "tcp",
            "grpc"
          ]
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "profile": {
          "type": "string",
          "enum": [
            "single-node",
            "small",
            "ha"
          ]
        },
        "topologySpread": {
          "type": "string",
          "enum": [
            "soft",
            "hard"
          ]
        },
        "metricsScraper": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "podLabels"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*$",
              "description": "Key of namespaces where the Prometheus scraper runs."
            },
            "podLabels": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^([a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?/)?[A-Za-z0-9]([A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]([A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?$"
              },
              "description": "Labels of the scraper pods. Only those pods in that namespace reach a scrapeMetrics service's health listener."
            }
          },
          "description": "The only pods that may reach /metrics on a service with scrapeMetrics (vws-deploy#620)."
        }
      }
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$"
          },
          {
            "not": {
              "pattern": "(^|-)agent$|hypervisor|-peers$"
            }
          }
        ]
      },
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/definitions/service"
          },
          {
            "$ref": "#/definitions/deployment-replicas"
          }
        ]
      },
      "properties": {
        "console-api": {
          "description": "console-api holds sessions in memory, so it runs exactly one replica (popododo0720/vws-console-api#95).",
          "allOf": [
            {
              "$ref": "#/definitions/service"
            },
            {
              "properties": {
                "replicas": {
                  "const": 1,
                  "description": "Exactly 1: console-api sessions are held in memory (popododo0720/vws-console-api#95)."
                },
                "autoscaling": false
              },
              "required": [
                "replicas"
              ]
            }
          ]
        }
      }
    },
    "namespaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*$",
        "not": {
          "const": "release"
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "otlpEndpoint",
        "otlpHeadersSecret",
        "defaults",
        "collector"
      ],
      "description": "OTel wiring of every service and the minimal collector (vws-deploy#50, docs/design/observability.md). enabled false renders nothing.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "otlpEndpoint": {
          "type": "string",
          "pattern": "^(https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?)?$",
          "description": "Empty runs the minimal collector; set sends every service to this OTLP endpoint and renders no collector."
        },
        "otlpHeadersSecret": {
          "type": "string",
          "pattern": "^([a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?)?$",
          "description": "Secret with key headers, rendered as OTEL_EXPORTER_OTLP_HEADERS by secretKeyRef. Needs otlpEndpoint."
        },
        "defaults": {
          "allOf": [
            {
              "$ref": "#/definitions/telemetry"
            },
            {
              "required": [
                "protocol",
                "sampler",
                "samplerArg",
                "logLevel",
                "resourceAttributes",
                "sentry"
              ],
              "properties": {
                "sentry": {
                  "required": [
                    "enabled",
                    "dsnSecret"
                  ]
                }
              }
            }
          ]
        },
        "collector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "cpu",
            "memory",
            "exporters"
          ],
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9./-]+/opentelemetry-collector-contrib:[0-9]+\\.[0-9]+\\.[0-9]+@sha256:[0-9a-f]{64}$",
              "description": "Pinned by tag and digest; the tag is OTELCOL_VERSION of scripts/versions.env."
            },
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+m$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi)$",
              "description": "Also the limit memory_limiter works from."
            },
            "exporters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "otlp",
                "debug"
              ],
              "properties": {
                "otlp": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "endpoint",
                    "insecure",
                    "authorizationSecret"
                  ],
                  "properties": {
                    "endpoint": {
                      "type": "string",
                      "pattern": "^([A-Za-z0-9.-]+:[0-9]{1,5}|https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?)?$",
                      "description": "Next OTLP gRPC hop. Empty sends nothing on."
                    },
                    "insecure": {
                      "type": "boolean"
                    },
                    "authorizationSecret": {
                      "type": "string",
                      "pattern": "^([a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?)?$",
                      "description": "Secret with key authorization, sent as the authorization header."
                    }
                  }
                },
                "debug": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiGroups",
        "resources",
        "verbs"
      ],
      "properties": {
        "apiGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[^*]*$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "crd"
                ],
                "properties": {
                  "crd": {
                    "enum": [
                      "vwsclusters"
                    ],
                    "description": "The API group of a chart CRD, read from crds/<crd>.yaml spec.group, so the VWSCluster group is written in one file only (R18)."
                  }
                }
              }
            ]
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^*]+$"
          }
        },
        "verbs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "get",
              "list",
              "watch",
              "create",
              "update",
              "patch",
              "delete"
            ]
          }
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "resourceNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Narrows the rule to these object names (vws-deploy#614). RBAC cannot limit create by name, so scripts/check_render.py refuses resourceNames on a rule with create.",
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageTag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
          "description": "Image tag of this service only; overrides global.tag and Chart appVersion (vws-deploy#280)."
        },
        "imageName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Repository under global.registry; absent means the service name. Never a full image reference."
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": [
            {
              "type": "string",
              "pattern": "^/"
            }
          ],
          "additionalItems": {
            "type": "string"
          },
          "description": "Container command, replacing the image entrypoint, such as the installer image's vws-installer admin subcommand. The first item is an absolute path. args stay exactly the flags (R14)."
        },
        "loopback": {
          "type": "boolean",
          "description": "The service listens on 127.0.0.1 only and has no auth of its own (the admin page, vws-deploy#391). The chart renders no Service, and the NetworkPolicy admits only healthPort for kubelet probes. Needs healthPort and flags.listen on 127.0.0.1."
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "description": "Second HTTP listener for /healthz and /readyz. Renders VWS_HEALTH_ADDR, a metrics container and Service port, and httpGet probes (vws-deploy#212). It must differ from port."
        },
        "httpProbes": {
          "type": "boolean",
          "description": "The app serves /healthz and /readyz on its service port. Renders httpGet probes on the http port (vws-deploy#612). Not with healthPort."
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "cpu": {
          "type": "string",
          "pattern": "^[0-9]+m$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*Gi$"
            }
          }
        },
        "external": {
          "type": "boolean"
        },
        "portEnv": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "rbac": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/rule"
          }
        },
        "startupSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600
        },
        "flags": {
          "$ref": "#/definitions/flags"
        },
        "pendingFlags": {
          "$ref": "#/definitions/flags"
        },
        "repeatedFlags": {
          "type": "object",
          "description": "Flags given once per list item, after flags, such as vws-storage -kube-volume-type (vws-deploy#391). A name must not also be in flags.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[^\\s]+$"
            }
          }
        },
        "grpcReadinessService": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
        },
        "kubeconfigSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "description": "Object backend wiring for the service that implements it (vws-storage). Keys come only from an operator-made Secret in the release namespace through secretKeyRef.",
          "properties": {
            "rgw": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "endpoint": {
                  "type": "string",
                  "pattern": "^(https?://[^\\s]+)?$"
                },
                "bucketPrefix": {
                  "type": "string",
                  "pattern": "^([a-z0-9][a-z0-9-]{0,17})?$"
                },
                "existingSecret": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?)?$"
                }
              }
            }
          }
        },
        "apiCredentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "description": "Credentials of a service that serves the console API (vws-console-api). Values come only from a Secret in the release namespace through secretKeyRef; vws apply creates it once when missing.",
          "properties": {
            "existingSecret": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
            }
          }
        },
        "apiClient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service"
          ],
          "description": "Wires a client of the console API: VWS_CONSOLE_API_URL from the named service's Service and port, VWS_CONSOLE_API_TOKEN from that service's apiCredentials Secret.",
          "properties": {
            "service": {
              "type": "string",
              "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$"
            }
          }
        },
        "enabled": {
          "type": "boolean",
          "description": "false leaves the service out of the render (a service whose image is not published yet). Absent means true."
        },
        "rootPasswordSecret": {
          "type": "string",
          "enum": ["vws-initial-admin"],
          "description": "Only vws-initial-admin: the installer and vws installer finish read that name. Secret in the release namespace with keys username (root) and password: the console-api account root's console password (vws-deploy#208). Mounted read-only (key password only) and passed as the derived -root-password-file only when flags.iam is fake or grpc; with -iam static console sign-in is off and nothing renders. vws apply creates it once when missing and never rotates it."
        },
        "kekSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$",
          "description": "Secret in the release namespace with keys kek (base64 of 32 random bytes) and key-id. Env VWS_IAM_KEK and VWS_IAM_KEK_ID by secretKeyRef; vws apply creates it once when missing and never rotates it."
        },
        "allowFrom": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "description": "A NetworkPolicy admits only pods of these services, on the service port."
        },
        "scrapeMetrics": {
          "type": "boolean",
          "description": "The NetworkPolicy admits the health listener (healthPort, which serves /metrics) only from global.metricsScraper. Needs healthPort (vws-deploy#620)."
        },
        "observability": {
          "$ref": "#/definitions/telemetry"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "replicas": {
                "maximum": 1,
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "loopback"
            ],
            "properties": {
              "loopback": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "healthPort",
              "flags"
            ],
            "properties": {
              "replicas": {
                "const": 1
              },
              "flags": {
                "required": [
                  "listen"
                ],
                "properties": {
                  "listen": {
                    "type": "string",
                    "pattern": "^127\\.0\\.0\\.1:[0-9]+$"
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "external"
                  ]
                },
                {
                  "required": [
                    "allowFrom"
                  ]
                },
                {
                  "required": [
                    "scrapeMetrics"
                  ]
                },
                {
                  "required": [
                    "httpProbes"
                  ]
                },
                {
                  "required": [
                    "state"
                  ]
                },
                {
                  "required": [
                    "portEnv"
                  ]
                }
              ]
            }
          }
        },
        {
          "description": "The admin page entrypoint (vws-installer admin) has no auth of its own, so a service that runs it must be loopback, under any service name (vws-deploy#391).",
          "if": {
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "contains": {
                  "const": "admin"
                }
              }
            }
          },
          "then": {
            "required": [
              "loopback"
            ],
            "properties": {
              "loopback": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "kubeconfigSecret"
            ]
          },
          "then": {
            "required": [
              "flags"
            ],
            "properties": {
              "flags": {
                "required": [
                  "kubeconfig"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "flags"
            ],
            "properties": {
              "flags": {
                "required": [
                  "kubeconfig"
                ]
              }
            }
          },
          "then": {
            "required": [
              "kubeconfigSecret"
            ]
          }
        }
      ]
    },
    "flags": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*$"
              }
            }
          }
        ]
      },
      "dependencies": {
        "kubeconfig": [
          "kube-external-subnet",
          "kube-nad-namespace"
        ],
        "kube-snat": [
          "kube-external-subnet"
        ]
      },
      "properties": {
        "kubeconfig": {
          "type": "string",
          "pattern": "^/[^/]+(/[^/]+)*/[^/]+$"
        }
      }
    },
    "deployment-replicas": {
      "description": "A stateless service runs at least two replicas, except console-api.",
      "if": {
        "not": {
          "required": [
            "state"
          ]
        }
      },
      "then": {
        "properties": {
          "replicas": {
            "minimum": 2
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-service OTel settings (vws-deploy#50). observability.defaults has every key; services.<name>.observability may set any of them and nothing else. Rendered by vws.otelEnv.",
      "properties": {
        "protocol": {
          "enum": [
            "grpc",
            "http/protobuf"
          ],
          "description": "OTEL_EXPORTER_OTLP_PROTOCOL"
        },
        "sampler": {
          "enum": [
            "always_on",
            "always_off",
            "traceidratio",
            "parentbased_always_on",
            "parentbased_always_off",
            "parentbased_traceidratio"
          ],
          "description": "OTEL_TRACES_SAMPLER"
        },
        "samplerArg": {
          "type": "string",
          "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$",
          "description": "OTEL_TRACES_SAMPLER_ARG, a ratio from 0 to 1"
        },
        "logLevel": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "description": "VWS_LOG_LEVEL"
        },
        "resourceAttributes": {
          "type": "object",
          "description": "OTEL_RESOURCE_ATTRIBUTES, sorted key=value pairs. A service's map merges over the defaults key by key.",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:/-]{1,255}$"
          }
        },
        "sentry": {
          "type": "object",
          "additionalProperties": false,
          "description": "enabled renders SENTRY_DSN by secretKeyRef from key dsn of dsnSecret. The DSN is never a value.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dsnSecret": {
              "type": "string",
              "pattern": "^([a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?)?$"
            }
          }
        }
      }
    }
  }
}
