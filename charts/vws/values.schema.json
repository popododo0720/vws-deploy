{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "namespaces",
    "services"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "storageClass"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*(/[a-z0-9._-]+)+$"
        },
        "storageClass": {
          "type": "string"
        },
        "pendingFlags": {
          "type": "boolean"
        },
        "probe": {
          "type": "string",
          "enum": [
            "tcp",
            "grpc"
          ]
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "profile": {
          "type": "string",
          "enum": [
            "single-node",
            "small",
            "ha"
          ]
        },
        "topologySpread": {
          "type": "string",
          "enum": [
            "soft",
            "hard"
          ]
        }
      }
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$"
          },
          {
            "not": {
              "pattern": "(^|-)agent$|hypervisor|-peers$"
            }
          }
        ]
      },
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/definitions/service"
          },
          {
            "$ref": "#/definitions/deployment-replicas"
          }
        ]
      },
      "properties": {
        "console-api": {
          "description": "console-api holds sessions in memory, so it runs exactly one replica (popododo0720/vws-console-api#95).",
          "allOf": [
            {
              "$ref": "#/definitions/service"
            },
            {
              "properties": {
                "replicas": {
                  "const": 1,
                  "description": "Exactly 1: console-api sessions are held in memory (popododo0720/vws-console-api#95)."
                },
                "autoscaling": false
              },
              "required": [
                "replicas"
              ]
            }
          ]
        }
      }
    },
    "namespaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*$",
        "not": {
          "const": "release"
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
      }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiGroups",
        "resources",
        "verbs"
      ],
      "properties": {
        "apiGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^*]*$"
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^*]+$"
          }
        },
        "verbs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "get",
              "list",
              "watch",
              "create",
              "update",
              "patch",
              "delete"
            ]
          }
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageTag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
          "description": "Image tag of this service only; overrides global.tag and Chart appVersion (vws-deploy#280)."
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "description": "Second HTTP listener for /healthz, /readyz and /metrics. Renders VWS_HEALTH_ADDR, a metrics container and Service port, httpGet probes and Prometheus scrape annotations (vws-deploy#212). It must differ from port."
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "cpu": {
          "type": "string",
          "pattern": "^[0-9]+m$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*Gi$"
            }
          }
        },
        "external": {
          "type": "boolean"
        },
        "portEnv": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "rbac": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/rule"
          }
        },
        "startupSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600
        },
        "flags": {
          "$ref": "#/definitions/flags"
        },
        "pendingFlags": {
          "$ref": "#/definitions/flags"
        },
        "repeatedFlags": {
          "type": "object",
          "description": "Flags given once per list item, after flags, such as vws-storage -kube-volume-type (vws-deploy#391). A name must not also be in flags.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[^\\s]+$"
            }
          }
        },
        "grpcReadinessService": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
        },
        "kubeconfigSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "description": "Object backend wiring for the service that implements it (vws-storage). Keys come only from an operator-made Secret in the release namespace through secretKeyRef.",
          "properties": {
            "rgw": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "endpoint": {
                  "type": "string",
                  "pattern": "^(https?://[^\\s]+)?$"
                },
                "bucketPrefix": {
                  "type": "string",
                  "pattern": "^([a-z0-9][a-z0-9-]{0,17})?$"
                },
                "existingSecret": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?)?$"
                }
              }
            }
          }
        },
        "apiCredentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "description": "Credentials of a service that serves the console API (vws-console-api). Values come only from a Secret in the release namespace through secretKeyRef; vws apply creates it once when missing.",
          "properties": {
            "existingSecret": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
            }
          }
        },
        "apiClient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service"
          ],
          "description": "Wires a client of the console API: VWS_CONSOLE_API_URL from the named service's Service and port, VWS_CONSOLE_API_TOKEN from that service's apiCredentials Secret.",
          "properties": {
            "service": {
              "type": "string",
              "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$"
            }
          }
        },
        "enabled": {
          "type": "boolean",
          "description": "false leaves the service out of the render (a service whose image is not published yet). Absent means true."
        },
        "kekSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$",
          "description": "Secret in the release namespace with keys kek (base64 of 32 random bytes) and key-id. Env VWS_IAM_KEK and VWS_IAM_KEK_ID by secretKeyRef; vws apply creates it once when missing and never rotates it."
        },
        "allowFrom": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "description": "A NetworkPolicy admits only pods of these services, on the service port."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "replicas": {
                "maximum": 1,
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "kubeconfigSecret"
            ]
          },
          "then": {
            "required": [
              "flags"
            ],
            "properties": {
              "flags": {
                "required": [
                  "kubeconfig"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "flags"
            ],
            "properties": {
              "flags": {
                "required": [
                  "kubeconfig"
                ]
              }
            }
          },
          "then": {
            "required": [
              "kubeconfigSecret"
            ]
          }
        }
      ]
    },
    "flags": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*$"
              }
            }
          }
        ]
      },
      "dependencies": {
        "kubeconfig": [
          "kube-external-subnet",
          "kube-nad-namespace"
        ],
        "kube-snat": [
          "kube-external-subnet"
        ]
      },
      "properties": {
        "kubeconfig": {
          "type": "string",
          "pattern": "^/[^/]+(/[^/]+)*/[^/]+$"
        }
      }
    },
    "deployment-replicas": {
      "description": "A stateless service runs at least two replicas, except console-api.",
      "if": {
        "not": {
          "required": [
            "state"
          ]
        }
      },
      "then": {
        "properties": {
          "replicas": {
            "minimum": 2
          }
        }
      }
    }
  }
}
