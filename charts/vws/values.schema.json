{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "namespaces",
    "services"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "storageClass"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*(/[a-z0-9._-]+)+$"
        },
        "storageClass": {
          "type": "string"
        },
        "pendingFlags": {
          "type": "boolean"
        },
        "probe": {
          "type": "string",
          "enum": [
            "tcp",
            "grpc"
          ]
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "profile": {
          "type": "string",
          "enum": [
            "single-node",
            "small",
            "ha"
          ]
        },
        "topologySpread": {
          "type": "string",
          "enum": [
            "soft",
            "hard"
          ]
        }
      }
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$"
          },
          {
            "not": {
              "pattern": "(^|-)agent$|hypervisor|-peers$"
            }
          }
        ]
      },
      "additionalProperties": {
        "$ref": "#/definitions/service"
      }
    },
    "namespaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*$",
        "not": {
          "const": "release"
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
      }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiGroups",
        "resources",
        "verbs"
      ],
      "properties": {
        "apiGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^*]*$"
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^*]+$"
          }
        },
        "verbs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "get",
              "list",
              "watch",
              "create",
              "update",
              "patch",
              "delete"
            ]
          }
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "cpu": {
          "type": "string",
          "pattern": "^[0-9]+m$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*Gi$"
            }
          }
        },
        "external": {
          "type": "boolean"
        },
        "rbac": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/rule"
          }
        },
        "startupSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600
        },
        "flags": {
          "$ref": "#/definitions/flags"
        },
        "pendingFlags": {
          "$ref": "#/definitions/flags"
        },
        "grpcReadinessService": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
        },
        "kubeconfigSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "description": "Object backend wiring for the service that implements it (vws-storage). Keys come only from an operator-made Secret in the release namespace through secretKeyRef.",
          "properties": {
            "rgw": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "endpoint": {
                  "type": "string",
                  "pattern": "^(https?://[^\\s]+)?$"
                },
                "bucketPrefix": {
                  "type": "string",
                  "pattern": "^([a-z0-9][a-z0-9-]{0,17})?$"
                },
                "existingSecret": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?)?$"
                }
              }
            }
          }
        },
        "apiCredentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "description": "Credentials of a service that serves the console API (vws-console-api). Values come only from a Secret in the release namespace through secretKeyRef; vws apply creates it once when missing.",
          "properties": {
            "existingSecret": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
            }
          }
        },
        "apiClient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service"
          ],
          "description": "Wires a client of the console API: VWS_CONSOLE_API_URL from the named service's Service and port, VWS_CONSOLE_API_TOKEN from that service's apiCredentials Secret.",
          "properties": {
            "service": {
              "type": "string",
              "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "replicas": {
                "maximum": 1,
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "replicas": {
                "minimum": 2
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "kubeconfigSecret"
            ]
          },
          "then": {
            "required": [
              "flags"
            ],
            "properties": {
              "flags": {
                "required": [
                  "kubeconfig"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "flags"
            ],
            "properties": {
              "flags": {
                "required": [
                  "kubeconfig"
                ]
              }
            }
          },
          "then": {
            "required": [
              "kubeconfigSecret"
            ]
          }
        }
      ]
    },
    "flags": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*$"
              }
            }
          }
        ]
      },
      "dependencies": {
        "kubeconfig": [
          "kube-external-subnet",
          "kube-nad-namespace"
        ],
        "kube-snat": [
          "kube-external-subnet"
        ]
      },
      "properties": {
        "kubeconfig": {
          "type": "string",
          "pattern": "^/[^/]+(/[^/]+)*/[^/]+$"
        }
      }
    }
  }
}
