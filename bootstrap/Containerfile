# The installer image: scripts/vws, the chart, the rendered platform bundle, helm and kubectl.
# Build from the repo root after scripts/platform.sh (build/platform must exist):
#   source scripts/versions.env
#   docker build -f bootstrap/Containerfile --build-arg BASE="$INSTALLER_BASE_IMAGE" \
#     --build-arg HELM_VERSION --build-arg HELM_SHA256 --build-arg KUBERNETES_VERSION --build-arg KUBECTL_SHA256 .
# Nothing here pushes. A release build pushes and pins the digest in VWS_INSTALLER_IMAGE.
ARG BASE
FROM ${BASE}
ARG HELM_VERSION
ARG HELM_SHA256
ARG KUBERNETES_VERSION
ARG KUBECTL_SHA256
RUN apk add --no-cache bash jq python3 py3-yaml curl ca-certificates \
 && curl -fsSL -o /tmp/helm.tgz "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" \
 && echo "${HELM_SHA256}  /tmp/helm.tgz" | sha256sum -c - \
 && tar -xzf /tmp/helm.tgz -C /tmp && install -m 0755 /tmp/linux-amd64/helm /usr/local/bin/helm \
 && curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/v${KUBERNETES_VERSION}/bin/linux/amd64/kubectl" \
 && echo "${KUBECTL_SHA256}  /usr/local/bin/kubectl" | sha256sum -c - && chmod 0755 /usr/local/bin/kubectl \
 && rm -rf /tmp/helm.tgz /tmp/linux-amd64 && apk del curl
COPY scripts /opt/vws/scripts
COPY charts /opt/vws/charts
COPY profiles /opt/vws/profiles
COPY build/platform /opt/vws/build/platform
ENV PATH=/opt/vws/scripts:$PATH
USER 65532:65532
ENTRYPOINT ["/opt/vws/scripts/vws"]
