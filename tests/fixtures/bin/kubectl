#!/usr/bin/env bash
# Fake kubectl for tests/vws. It never talks to a cluster.
# Every call is appended to $VWS_FAKE_LOG as: tool<TAB>verb<TAB>all arguments.
# The answer is the file $VWS_FAKE_DIR/kubectl/<verb>_<resource>.json (a "/" in the resource becomes "_").
# A more specific file $VWS_FAKE_DIR/kubectl/<verb>_<arg1>_<arg2>_<arg3>.json wins when it exists
# ("*" becomes "all"), so for example auth can-i can answer per verb and resource.
# A file <name>.fail instead makes the call fail with that text on stderr.
# A call without such a file fails loudly, so a test never passes on an unplanned call.
set -euo pipefail
: "${VWS_FAKE_LOG:?}" "${VWS_FAKE_DIR:?}"
verb='' resource='' skip=0 positional=()
for arg in "$@"; do
  if ((skip)); then skip=0; continue; fi
  case $arg in
    --context | --namespace | -n | -o) skip=1 ;;
    -*) ;;
    *)
      positional+=("$arg")
      if [[ -z $verb ]]; then verb=$arg; elif [[ -z $resource ]]; then resource=$arg; fi
      ;;
  esac
done
printf 'kubectl\t%s\t%s\n' "$verb" "$*" >>"$VWS_FAKE_LOG"
# "-f -": the document on stdin is appended to $VWS_FAKE_LOG.stdin after a "--- <verb>" line.
prev=''
for arg in "$@"; do
  if [[ $prev == -f && $arg == - ]]; then
    { echo "--- ${verb}"; cat; echo; } >>"${VWS_FAKE_LOG}.stdin"
    break
  fi
  prev=$arg
done
file="${VWS_FAKE_DIR}/kubectl/${verb}_${resource//\//_}.json"
if ((${#positional[@]} >= 4)); then
  specific=$(IFS=_; echo "${positional[*]:0:4}")
  specific=${specific//\*/all}
  specific=${specific//\//_}
  [[ ! -f ${VWS_FAKE_DIR}/kubectl/${specific}.json ]] || file="${VWS_FAKE_DIR}/kubectl/${specific}.json"
fi
# <name>.fail next to the fixture: its text goes to stderr and the call exits 1 (a server refusal).
if [[ -f ${file%.json}.fail ]]; then
  cat "${file%.json}.fail" >&2
  exit 1
fi
if [[ ! -f $file ]]; then
  echo "fake kubectl: no fixture ${file}" >&2
  exit 1
fi
cat "$file"
