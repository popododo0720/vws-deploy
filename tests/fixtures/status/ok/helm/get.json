{
  "global": {
    "profile": "single-node",
    "topologySpread": "soft"
  },
  "services": {
    "compute": {
      "cpu": "100m",
      "memory": "256Mi",
      "state": {
        "size": "20Gi"
      }
    },
    "console": {
      "cpu": "100m",
      "memory": "256Mi",
      "replicas": 2
    },
    "console-api": {
      "cpu": "100m",
      "memory": "256Mi",
      "replicas": 1,
      "flags": {
        "console-origins": "https://console.example.invalid"
      }
    },
    "network": {
      "cpu": "100m",
      "memory": "256Mi",
      "state": {
        "size": "20Gi"
      },
      "flags": {
        "pool": "198.18.0.0/24",
        "vm-mtu": 9001
      }
    },
    "storage": {
      "cpu": "100m",
      "memory": "256Mi",
      "state": {
        "size": "20Gi"
      }
    }
  }
}
