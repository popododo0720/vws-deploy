     "app.kubernetes.io/version": "0.1.0",
     "helm.sh/chart": "vws-0.1.0"
    }
   },
   "spec": {
    "replicas": 2,
    "selector": {
     "matchLabels": {
      "app.kubernetes.io/name": "console",
      "app.kubernetes.io/instance": "vws"
     }
    },
    "strategy": {
     "type": "RollingUpdate",
     "rollingUpdate": {
      "maxUnavailable": 0,
      "maxSurge": 1
     }
    },
    "template": {
     "metadata": {
      "labels": {
       "app.kubernetes.io/name": "console",
       "app.kubernetes.io/instance": "vws",
       "app.kubernetes.io/part-of": "vws",
       "app.kubernetes.io/component": "control-plane",
       "app.kubernetes.io/version": "0.1.0",
       "helm.sh/chart": "vws-0.1.0"
      }
     },
     "spec": {
      "restartPolicy": "Always",
      "serviceAccountName": "console",
      "automountServiceAccountToken": false,
      "enableServiceLinks": false,
      "terminationGracePeriodSeconds": 30,
      "securityContext": {
       "runAsNonRoot": true,
       "runAsUser": 65532,
       "runAsGroup": 65532,
       "fsGroup": 65532,
       "fsGroupChangePolicy": "OnRootMismatch",
       "seccompProfile": {
        "type": "RuntimeDefault"
       }
      },
      "topologySpreadConstraints": [
       {
        "maxSkew": 1,
        "topologyKey": "kubernetes.io/hostname",
        "whenUnsatisfiable": "ScheduleAnyway",
        "labelSelector": {
         "matchLabels": {
          "app.kubernetes.io/name": "console",
          "app.kubernetes.io/instance": "vws"
         }
        }
       }
      ],
      "containers": [
       {
        "name": "console",
        "image": "ghcr.io/popododo0720/vws/console:0.1.0",
        "imagePullPolicy": "IfNotPresent",
        "ports": [
         {
          "name": "http",
          "containerPort": 8080
         }
        ],
        "env": [
         {
          "name": "VWS_SERVICE_NAME",
          "value": "console"
         }
        ],
        "startupProbe": {
         "tcpSocket": {
          "port": "http"
         },
         "periodSeconds": 5,
         "timeoutSeconds": 2,
         "failureThreshold": 13
        },
        "livenessProbe": {
         "tcpSocket": {
          "port": "http"
         },
         "periodSeconds": 10,
         "timeoutSeconds": 2,
         "failureThreshold": 3
        },
        "readinessProbe": {
         "tcpSocket": {
          "port": "http"
         },
         "periodSeconds": 5,
         "timeoutSeconds": 2,
         "failureThreshold": 2
        },
        "resources": {
         "requests": {
          "cpu": "100m",
          "memory": "256Mi"
         },
         "limits": {
          "memory": "256Mi"
         }
        },
        "securityContext": {
         "allowPrivilegeEscalation": false,
         "readOnlyRootFilesystem": true,
         "capabilities": {
          "drop": [
           "ALL"
          ]
         }
        },
        "volumeMounts": [
         {
          "name": "tmp",
          "mountPath": "/tmp"
         }
        ]
       }
      ],
      "volumes": [
       {
        "name": "tmp",
        "emptyDir": {}
       }
      ]
     }
    }
   },
   "status": {
    "readyReplicas": 2,
    "replicas": 2
   }
